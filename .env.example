# =============================================================
# Django 基本設定
# =============================================================
# 必ず設定してください（推測されにくいランダムな文字列）
SECRET_KEY=

# 本番運用では False にしてください
DEBUG=True

# 公開する場合は必ず絞ってください。カンマ区切り（既定: * = 全許可）
#ALLOWED_HOSTS=example.com,192.0.2.10

# データ更新画面が 403 になる場合に設定します。スキーム込み・カンマ区切り
#CSRF_TRUSTED_ORIGINS=https://example.com

# =============================================================
# データベース設定
# =============================================================
POSTGRES_DB=gfdash_db
POSTGRES_USER=dash_admin
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432

# =============================================================
# スーパーユーザーの自動作成（初回起動時）
# =============================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# =============================================================
# Web サーバ (gunicorn)
# =============================================================
# 同時に処理できるリクエスト数は「ワーカー数 × スレッド数」です
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=4

# =============================================================
# 画面の挙動
# =============================================================
# True にするとログイン不要で全画面を閲覧できます。
# インターネット上で有効にすると誰でも閲覧できる状態になります（既定: False）
#IS_SAMPLE_MODE=False

# 休業・祝日カレンダー(913)で過去日を編集できるようにするか（既定: True）
# 来場実績を外部システムから取り込んでいる場合は False を推奨します
#ALLOW_PAST_CALENDAR_EDIT=True

# --- 第2休日カレンダー ----------------------------------------
# 国民の祝日とは異なる休日体系を持つ顧客層がある場合に使います。
# 有効にすると、カレンダー名称を tz901_com_name の code:008 に設定できます。
#ENABLE_HOLIDAY2=False

# 第2休日を来場者予測の回帰変数として使うか（既定: False）
# 有効にする前に、来場実績の全期間ぶんを登録してください。
# 一部の期間しか登録していないと、精度がかえって落ちます。
#ENABLE_HOLIDAY2_FORECAST=False

# =============================================================
# AI機能（Prophet 予測 / LLM レポート生成）
# =============================================================
# バッチ処理を有効にする場合は False にしてください
DISABLE_BATCH_EXECUTION=True

# --- 推論エンジンの選択 ---------------------------------------
# ollama : Ollama のネイティブAPI（既定）
# openai : OpenAI互換API（FreeToken / llama.cpp server / vLLM / LM Studio 等）
#          コンテキスト長と思考の切り替えは推論エンジン側の設定に従います
#LLM_PROVIDER=ollama

# Ollama のエンドポイント（LLM_PROVIDER=ollama のとき）
# Docker からホストの Ollama を使う場合は既定のままで動作します
#OLLAMA_API_URL=http://host.docker.internal:11434/api/generate

# OpenAI互換APIの接続先（LLM_PROVIDER=openai のとき）。/v1 まで含めます
#OPENAI_API_BASE=http://host.docker.internal:8080/v1

# 同上の認証キー。ローカルの推論エンジンでは通常不要です
#OPENAI_API_KEY=

# --- モデル ---------------------------------------------------
# 使用するモデル名
#OLLAMA_MODEL=gemma4:e4b

# 画面からモデルを選べるようにするか（既定: True）
#OLLAMA_ALLOW_MODEL_SELECT=True

# --- 実行パラメータ -------------------------------------------
# 通常はプリセットの指定だけで十分です（既定: standard）
# standard     : 通常はこれ                    (4096 / 300秒 / 思考なし)
# long_running : タイムアウトする場合            (4096 / 1800秒 / 思考なし)
# low_memory   : モデルが読み込めない、極端に遅い (2048 / 900秒 / 思考なし)
# high_context : 多くの実績データを渡したい       (8192 / 900秒 / 思考なし)
# thinking     : 多段の推論をさせる場合          (16384 / 1800秒 / 思考あり)
#OLLAMA_PRESET=standard

# 個別に指定する場合のみ有効化してください（プリセットより優先されます）
#OLLAMA_NUM_CTX=4096
#OLLAMA_TIMEOUT=300
#OLLAMA_THINK=False

# --- 調査用 ---------------------------------------------------
# 送信するプロンプトをログに出力するか（既定: False）
#OLLAMA_LOG_PROMPT=False

# =============================================================
# ファイルの配置（既定のままで動作します）
# =============================================================
#STATIC_ROOT=/var/www/gfdash/static
#MEDIA_ROOT=/var/lib/gfdash/media
#STATICFILES_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage