# Django基本設定
SECRET_KEY=
DEBUG=True

# データベース設定
POSTGRES_DB=gfdash_db
POSTGRES_USER=dash_admin
POSTGRES_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- スーパーユーザー自動作成用の設定 ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# --- AI機能の設定（任意） ---
# AI予測・LLMレポート生成のバッチ処理を有効にする場合は False
DISABLE_BATCH_EXECUTION=True
# Ollama へ送るプロンプトをログ出力する場合は True
OLLAMA_LOG_PROMPT=False
